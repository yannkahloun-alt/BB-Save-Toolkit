  "schema": "bb-archetypes-v1.0",
  "semantics": {
    "baseline": "Level-11 natural-stat neutral point and soft floor. At baseline contribution is zero; below baseline contribution is negative; above baseline contribution is positive up to target.",
    "ceiling": "Optional archetype/stat Fit-valuation saturation point. Projected values remain unchanged; only utility is evaluated at min(projected/effective value, ceiling). Must be finite and >= target.",
    "perks.recommended": "Strongly characteristic perks; informative only for now.",
    "perks.required": "Structural perks without which the build is not really this archetype.",
    "stat_absent": "The archetype does not evaluate this stat for Fit.",
    "target": "Level-11 natural-stat target and positive Fit saturation point. At or above target, this stat contributes its maximum positive weight.",
    "weight": "Maximum absolute influence of this stat on Fit. Signed per-stat contribution is bounded from -weight to +weight."
  },
  "status": "ACTIVE"
